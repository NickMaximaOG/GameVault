# Copy to .env and change every password before any real use.
# Used by docker-compose.yml; the same names work when running the pieces by hand.
MYSQL_ROOT_PASSWORD=change-me-root-Passw0rd
DB_PASSWORD=change-me-app-Passw0rd        # password of the gv_app account created by database/security.sql
DB_USER=gv_app
DB_URL=jdbc:mariadb://localhost:3306/gamevault_db
DB_POOL_SIZE=10
PORT=8080                                  # Java API port
CORS_ORIGIN=http://localhost:3000          # Origin allowed to call the API directly (the Node server calls it server-side)
SESSION_TTL_HOURS=8
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
AUTH_RATE_PER_MINUTE=20
TRUST_PROXY=false                          # true only behind a reverse proxy you control
# Node frontend
WEB_PORT=3000
BACKEND_URL=http://localhost:8080
COOKIE_SECURE=false                        # set true when served over HTTPS
